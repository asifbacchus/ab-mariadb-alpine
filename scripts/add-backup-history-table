#!/bin/sh

#
# Add the mysql.backup_history_table
#    This table is required for '--history' notations when performing an online
#    backup. Without this table, the process will exit with an error.
#    This script allows for pre-creating the table so that appropriate grants
#    can be set for backup users.
#

cleanExit() {
  shred -u "$SQL_FILE" >/dev/null 2>&1
  [ -n "$1" ] && exit "$1" || exit 0
}

scriptHelp() {
  printf "\nAdd the 'mysql.backup_history_table' to a MariaDB instance.\n"
  printf "USAGE: %s\n" "$SCRIPT_NAME"
  printf "\tThis script has no parameters.\n\n"
  exit 0
}

# initialize variables
SCRIPT_NAME="$(basename "$0")"
SQL_BACKUP_HISTORY_TABLE=$(
  cat << 'ENDBLOCK'
USE mysql;
CREATE TABLE IF NOT EXISTS `mariadb_backup_history` (
  `uuid` varchar(40) NOT NULL,
  `name` varchar(255) DEFAULT NULL,
  `tool_name` varchar(255) DEFAULT NULL,
  `tool_command` text DEFAULT NULL,
  `tool_version` varchar(255) DEFAULT NULL,
  `ibbackup_version` varchar(255) DEFAULT NULL,
  `server_version` varchar(255) DEFAULT NULL,
  `start_time` timestamp NULL DEFAULT NULL,
  `end_time` timestamp NULL DEFAULT NULL,
  `lock_time` bigint(20) unsigned DEFAULT NULL,
  `binlog_pos` varchar(128) DEFAULT NULL,
  `innodb_from_lsn` bigint(20) unsigned DEFAULT NULL,
  `innodb_to_lsn` bigint(20) unsigned DEFAULT NULL,
  `partial` enum('Y','N') DEFAULT NULL,
  `incremental` enum('Y','N') DEFAULT NULL,
  `format` enum('file','tar','mbstream') DEFAULT NULL,
  `compressed` enum('Y','N') DEFAULT NULL,
  PRIMARY KEY (`uuid`)
);
ENDBLOCK
)

while [ $# -gt 0 ]; do
  case "$1" in
  -h | -\? | --help)
    # show help
    scriptHelp
    ;;
  *)
    printf "\nUnknown option: %s\n" "$1"
    printf "Use '--help' for script usage information.\n\n"
    exit 1
    ;;
  esac
  shift
done

# preflight checks
if [ "$(id -u)" -ne 0 ]; then
  printf "\nScript must be run as ROOT. Exiting.\n\n"
  exit 2
fi

if (! command -v mariadb >/dev/null 2>&1); then\
  printf "\nMariaDB not found. Exiting.\n\n"
  exit 3
fi

# create the SQL temp file
SQL_FILE="$(mktemp -t ${SCRIPT_NAME}_XXXXXXXX)"

# assemble the SQL command and run it
printf "%s" "$SQL_BACKUP_HISTORY_TABLE" >"$SQL_FILE"
if (! mariadb <"$SQL_FILE"); then
  printf "\nERROR: There was an error creating the backup history table.\n\n"
  cleanExit 12
else
  printf "\nSUCCESS: Backup history table has been created.\n"
  printf "\tPlease update backup user permissions for this table accordingly.\n"
  printf "\n"
fi

# cleanup and exit gracefully
cleanExit

### Exit codes: (0-9: Script/System, 10-19: SQL)
# 0:    Normal exit, no errors.
# 1:    Script parameter or environment variable set/read incorrectly or
#         contain invalid values.
# 2:    Incorrect permissions. For example, the script must be run as root.
# 3:    Required programs or libraries are missing.
# 12:   SQL: Error creating, importing, or executing SQL commands.

#EOF
