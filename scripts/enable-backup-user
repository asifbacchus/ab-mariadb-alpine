#!/bin/sh

#
# Create/enable user to perform online backups
#

# instantiate variables
SCRIPT_NAME="$(basename "$0")"
BACKUP_USERNAME=""
BACKUP_PASSWORD=""

cleanExit() {
  \rm -f "$SQL_FILE" >/dev/null 2>&1
  [ -n "$1" ] && exit "$1" || exit 0
}

scriptHelp() {
  printf "\nCreate or enable an existing user to perform online backups:\n"
  printf "USAGE: %s --username username [--password password]\n" "$SCRIPT_NAME"
  printf "\t--username | -u: MariaDB user to create/enable for backups (required)\n"
  printf "\t--password | -p: Password for the backup user. If not supplied, a password will be auto-generated (NOT recommended)\n"
  printf "\n"
  exit 0
}

[ -z "$1" ] && scriptHelp
while [ $# -gt 0 ]; do
  case "$1" in
  -h | -\? | --help)
  # show help
    scriptHelp
    ;;
  -u | --username)
    # specify the user to create/enable
    if [ -n "$2" ]; then
      BACKUP_USERNAME="$2"
      shift
    else
      printf "\nUsername cannot be null or empty. Exiting.\n\n"
      exit 1
    fi
    ;;
  -p | --password)
  # specify the user's password
    BACKUP_PASSWORD="$2"
    shift
    ;;
  *)
    printf "\nUnknown option: %s\n" "$1"
    printf "Use '--help' for script usage information.\n\n"
    exit 1
    ;;
  esac
  shift
done

# preflight checks
if [ "$(id -u)" -ne 0 ]; then
  printf "\nScript must be run as ROOT. Exiting.\n\n"
  exit 1
fi

if (! command -v mariadbd >/dev/null 2>&1); then \
  printf "\nMariaDB not found. Exiting.\n\n"
  exit 1
fi

if [ "$BACKUP_USERNAME" = "root" ]; then
  printf "\nUser 'root' already has appropriate permissions. Exiting.\n\n"
  exit 0
fi

# check/generate password
if [ -z "$BACKUP_PASSWORD" ]; then
  BACKUP_PASSWORD="$(head /dev/urandom | tr -dc A-Za-z0-9 | head -c32)"
fi

# create the SQL temp file
SQL_FILE="$(mktemp -t ${SCRIPT_NAME}_XXXXXXXX.sql)"
printf "CREATE USER IF NOT EXISTS \`%s\`@\`localhost\` IDENTIFIED BY \`%s\`;\n" "$BACKUP_USERNAME" "$BACKUP_PASSWORD" >>"$SQL_FILE"
printf "GRANT RELOAD, PROCESS, LOCK TABLES, BINLOG MONITOR, REPLICATION CLIENT ON *.* TO \`%s\`@\`localhost\`;\n" "$BACKUP_USERNAME" >>"$SQL_FILE"
printf "GRANT ALTER on mysql.mariadb_backup_history TO \`%s\`@\`localhost\`;\n" "$BACKUP_USERNAME" >>"$SQL_FILE"
printf "FLUSH PRIVILEGES;\n" >>"$SQL_FILE"

# execute the SQL commands
if (! mariadbd <"$SQL_FILE"); then
  printf "\nERROR: There was an error creating/updating user '%s'.\n\n" "$BACKUP_USERNAME"
  cleanExit 2
else
  printf "\nSUCCESS: User '%s' can now perform online backups.\n" "$BACKUP_USERNAME"
  printf "\n"
fi

# exit gracefully
cleanExit
