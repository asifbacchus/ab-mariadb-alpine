#!/bin/sh

#
# Create/enable user to perform online backups
#

# instantiate variables
SCRIPT_NAME="$(basename "$0")"
BUSER="$BACKUP_USER"
BPASSWORD="$BACKUP_USER_PASSWORD"

cleanExit() {
  shred -u "$SQL_FILE" >/dev/null 2>&1
  [ -n "$1" ] && exit "$1" || exit 0
}

scriptHelp() {
  printf "\nCreate or enable an existing user to perform online backups:\n"
  printf "USAGE: %s [--username username] [--password password]\n\n" "$SCRIPT_NAME"
  printf "If no username is provided, a user will be created corresponding to the values from the '\$BACKUP_USER' and\n"
  printf "\t'\$BACKUP_USER_PASSWORD' environment variables, the former setting the username and the latter setting the\n"
  printf "\tpassword.\n"
  printf "If a username is provided and no corresponding account exists, it will be created using the provided password.\n"
  printf "\tIf no password is provided, the value of '\$BACKUP_USER_PASSWORD' will be used. If that value is null or\n"
  printf "\tempty, the script will exit with an error.\n"
  printf "If a username is provided and an '@localhost' account already exists, the necessary permissions will be\n"
  printf "\tadded to that account, but NO changes will be made to the account's password.\n"
  printf "\n"
  printf "\t--username | -u: MariaDB user to create/enable for backups\n"
  printf "\t\t(default: \$BACKUP_USER environment variable value)\n"
  printf "\t--password | -p: Password to use for a newly created account.\n"
  printf "\t\t(default: \$BACKUP_USER_PASSWORD environment variable value)\n"
  printf "\n"
  exit 0
}

while [ $# -gt 0 ]; do
  case "$1" in
  -h | -\? | --help)
  # show help
    scriptHelp
    ;;
  -p | --password)
  # specify the password to use
    if [ -n "$2" ]; then
      BPASSWORD="$2"
      shift
    else
      printf "\nPassword cannot be null or empty. Omit this parameter to use the default. Exiting.\n\n"
      exit 1
    fi
    ;;
  -u | --username)
    # specify the user to create/enable
    if [ -n "$2" ]; then
      BUSER="$2"
      shift
    else
      printf "\nUsername cannot be null or empty. Omit this parameter to use the default. Exiting.\n\n"
      exit 1
    fi
    ;;
  *)
    printf "\nUnknown option: %s\n" "$1"
    printf "Use '--help' for script usage information.\n\n"
    exit 1
    ;;
  esac
  shift
done

# preflight checks
if [ "$(id -u)" -ne 0 ]; then
  printf "\nScript must be run as ROOT. Exiting.\n\n"
  exit 2
fi

if (! command -v mariadb >/dev/null 2>&1); then \
  printf "\nMariaDB not found. Exiting.\n\n"
  exit 3
fi

if [ "$BUSER" = "root" ]; then
  printf "\nUser 'root' already has appropriate permissions. Exiting.\n\n"
  exit 0
fi

# check if the specified user@localhost exists, thus $BPASSWORD can be empty
UNAMECHECK=$(
  printf "SELECT EXISTS(SELECT 1 FROM mysql.user WHERE user = '%s' AND host = 'localhost');" "$BUSER" |
    mariadb --silent 2>/dev/null
)

# check if the backup user's password is set, if required
if [ ${UNAMECHECK} -eq 0 ] && [ -z "$BPASSWORD" ]; then \
  printf "\nBackup user password is null. This is not a safe configuration. Exiting.\n\n"
  exit 1
fi

# create the SQL temp file
SQL_FILE="$(mktemp -t ${SCRIPT_NAME}_XXXXXXXX)"
printf "CREATE USER IF NOT EXISTS \`%s\`@\`localhost\` IDENTIFIED BY '%s';\n" "$BUSER" "$BPASSWORD" >>"$SQL_FILE"
printf "GRANT RELOAD, PROCESS, LOCK TABLES, BINLOG MONITOR ON *.* TO \`%s\`@\`localhost\`;\n" "$BUSER" >>"$SQL_FILE"
printf "GRANT ALTER, INSERT, SELECT on mysql.mariadb_backup_history TO \`%s\`@\`localhost\`;\n" "$BUSER" >>"$SQL_FILE"
printf "FLUSH PRIVILEGES;\n" >>"$SQL_FILE"

# execute the SQL commands
if (! mariadb <"$SQL_FILE"); then
  printf "\nERROR: There was an error creating/updating user '%s'.\n\n" "$BUSER"
  cleanExit 12
else
  printf "\nSUCCESS: User '%s' can now perform online backups.\n" "$BUSER"
  printf "\n"
fi

# exit gracefully
cleanExit

### Exit codes: (0-9: Script/System, 10-19: SQL)
# 0:    Normal exit, no errors.
# 1:    Script parameter or environment variable set/read incorrectly or
#         contain invalid values.
# 2:    Incorrect permissions. For example, the script must be run as root.
# 3:    Required programs or libraries are missing.
# 12:   SQL: Error creating, importing, or executing SQL commands.

#EOF
